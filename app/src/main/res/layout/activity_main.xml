<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

<ScrollView
    android:id="@+id/content_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tagline"
                    android:textColor="@color/ink_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settings_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_secondary_button"
                android:contentDescription="@string/settings"
                android:padding="13dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/ink" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_mode_container"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/mode_streamer_button"
                style="@style/ModeButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/mode_stream" />

            <Button
                android:id="@+id/mode_receiver_button"
                style="@style/ModeButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/mode_receive" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/streamer_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <LinearLayout style="@style/Card" android:orientation="vertical">
                <TextView style="@style/Eyebrow" android:text="@string/source" />
                <TextView style="@style/CardTitle" android:layout_marginTop="6dp"
                    android:text="@string/stream_prompt" />

                <RadioGroup
                    android:id="@+id/stream_type_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/video_audio_radio"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:buttonTint="@color/brand"
                        android:checked="true"
                        android:gravity="center_vertical"
                        android:text="@string/video_and_audio"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/audio_only_radio"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:buttonTint="@color/brand"
                        android:gravity="center_vertical"
                        android:text="@string/audio_only"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/video_resolution_label"
                    style="@style/FieldLabel"
                    android:layout_marginTop="12dp"
                    android:text="@string/video_resolution" />

                <Spinner
                    android:id="@+id/video_resolution_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <LinearLayout style="@style/Card" android:layout_marginTop="12dp"
                android:orientation="vertical">
                <TextView android:id="@+id/stream_status_text" style="@style/StatusText"
                    android:text="@string/stopped" />
                <TextView
                    android:id="@+id/endpoint_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_code"
                    android:fontFamily="monospace"
                    android:padding="14dp"
                    android:text="@string/stream_url_placeholder"
                    android:textColor="@color/brand_dark"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />
                <TextView android:id="@+id/stream_message_text" style="@style/BodyText"
                    android:layout_marginTop="12dp"
                    android:text="@string/stream_instructions" />
                <Button android:id="@+id/copy_address_button" style="@style/SecondaryButton"
                    android:layout_marginTop="14dp" android:text="@string/copy_address" />
                <Button android:id="@+id/show_qr_button" style="@style/SecondaryButton"
                    android:layout_marginTop="10dp" android:text="@string/show_pairing_qr" />
            </LinearLayout>

            <Button
                android:id="@+id/stream_toggle_button"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="@string/start_stream" />

            <Button
                android:id="@+id/standby_toggle_button"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/start_standby" />

            <TextView
                style="@style/BodyText"
                android:layout_marginTop="8dp"
                android:text="@string/streamer_password_features" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/receiver_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/receiver_setup_card"
                style="@style/Card"
                android:orientation="vertical">
                <TextView style="@style/Eyebrow" android:text="@string/destination" />
                <TextView style="@style/CardTitle" android:layout_marginTop="6dp"
                    android:text="@string/connect_prompt" />
                <TextView style="@style/FieldLabel" android:layout_marginTop="16dp"
                    android:text="@string/nearby_devices" />
                <Spinner
                    android:id="@+id/nearby_devices_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/refresh_devices_button"
                        style="@style/SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/refresh" />
                    <Button
                        android:id="@+id/scan_qr_button"
                        style="@style/SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/scan_pairing_qr" />
                </LinearLayout>
                <EditText
                    android:id="@+id/receiver_host_input"
                    style="@style/Input"
                    android:layout_marginTop="16dp"
                    android:hint="@string/local_ip_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:singleLine="true" />
                <EditText
                    android:id="@+id/receiver_username_input"
                    style="@style/Input"
                    android:layout_marginTop="10dp"
                    android:hint="@string/stream_username"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true" />
                <EditText
                    android:id="@+id/receiver_password_input"
                    style="@style/Input"
                    android:layout_marginTop="10dp"
                    android:hint="@string/stream_password_optional"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:singleLine="true" />
                <TextView
                    style="@style/BodyText"
                    android:layout_marginTop="6dp"
                    android:text="@string/receiver_password_help" />
                <CheckBox
                    android:id="@+id/listen_only_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:buttonTint="@color/brand"
                    android:minHeight="48dp"
                    android:text="@string/listen_only"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/connect_button"
                    style="@style/PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="@string/connect" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/receiver_connection_card"
                style="@style/Card"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView style="@style/Eyebrow" android:text="@string/connected_to" />

                <TextView
                    android:id="@+id/receiver_url_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_code"
                    android:fontFamily="monospace"
                    android:padding="14dp"
                    android:textColor="@color/brand_dark"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/receiver_state_text"
                    style="@style/BodyText"
                    android:layout_marginTop="12dp"
                    android:text="@string/connecting"
                    android:textColor="@color/warning" />

                <TextView
                    android:id="@+id/streamer_battery_text"
                    style="@style/BodyText"
                    android:layout_marginTop="10dp"
                    android:text="@string/battery_waiting"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/remote_features_notice"
                    style="@style/BodyText"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_code"
                    android:padding="12dp"
                    android:text="@string/remote_features_need_password"
                    android:textColor="@color/brand_dark"
                    android:visibility="gone" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/player_view"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/video_background"
                    app:resize_mode="fit"
                    app:show_buffering="when_playing"
                    app:show_shuffle_button="false"
                    app:use_controller="true" />

                <Button
                    android:id="@+id/pip_button"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="10dp"
                    android:text="@string/picture_in_picture"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/audio_playback_text"
                    style="@style/CardTitle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp"
                    android:text="@string/audio_stream_playing"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/remote_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <TextView style="@style/Eyebrow" android:text="@string/remote_camera" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/switch_camera_button"
                            style="@style/SecondaryButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/switch_camera" />
                        <Button
                            android:id="@+id/torch_button"
                            style="@style/SecondaryButton"
                            android:layout_width="0dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/torch_on" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/zoom_label"
                        style="@style/FieldLabel"
                        android:layout_marginTop="12dp"
                        android:text="@string/zoom_default" />
                    <SeekBar
                        android:id="@+id/zoom_seek"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/brand"
                        android:thumbTint="@color/brand" />
                    <TextView style="@style/FieldLabel" android:text="@string/remote_resolution" />
                    <Spinner
                        android:id="@+id/remote_resolution_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/talk_button"
                    style="@style/PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:text="@string/hold_to_talk" />

                <Button android:id="@+id/resume_receiver_button" style="@style/PrimaryButton"
                    android:layout_width="match_parent"
                    android:text="@string/resume_live" android:visibility="gone"
                    android:layout_marginTop="12dp" />
                <Button
                    android:id="@+id/disconnect_button"
                    style="@style/SecondaryButton"
                    android:layout_marginTop="16dp"
                    android:text="@string/disconnect" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/privacy_summary"
            android:textColor="@color/ink_faint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

    <ViewStub
        android:id="@+id/pip_player_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/pip_player_view"
        android:layout="@layout/view_pip_player" />
</FrameLayout>
